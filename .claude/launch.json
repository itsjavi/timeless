{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-F", "@apps/web", "run", "dev"],
      "port": 6339,
      "autoPort": true
    },
    {
      "name": "storylite",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-F", "@apps/stories", "exec", "storylite", "dev"],
      "port": 1992,
      "autoPort": true
    },
    {
      "name": "dist-site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "preview:site"],
      "port": 4399,
      "autoPort": true
    }
  ]
}
