{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--filter=@apps/web"],
      "port": 6339
    },
    {
      "name": "storylite",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["-F", "@apps/stories", "exec", "storylite", "dev"],
      "port": 1992,
      "autoPort": true
    },
    {
      "name": "dist-site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-F",
        "@apps/web",
        "exec",
        "vite",
        "preview",
        "--host",
        "0.0.0.0",
        "--port",
        "4399",
        "--outDir",
        "../../dist-site"
      ],
      "port": 4399
    }
  ]
}
