{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "printWidth": 100,
  "trailingComma": "all",
  "tabWidth": 2,
  "proseWrap": "always",
  "singleQuote": true,
  "arrowParens": "always",
  "importOrder": ["^@timelessui/(.*)$", "^[./]"],
  "jsxSingleQuote": false,
  "svelte": true,
  "quoteProps": "as-needed",
  "sortPackageJson": true,
  "ignorePatterns": [
    "build/",
    "dist/",
    ".git/",
    ".next/",
    ".vercel/",
    ".astro/",
    ".turbo/",
    ".svelte/",
    ".svelte-kit/",
    ".remix/",
    ".react-router/",
    "node_modules/",
    ".yarn/",
    ".cache/",
    ".pnpm-store/",
    "coverage/",
    ".wrangler/",
    "*.min.json",
    "pnpm-*.yaml",
    "workbench/local/",
    ".local/",
    "public/",
    "*-index.json",
    "*.min.json"
  ]
}
