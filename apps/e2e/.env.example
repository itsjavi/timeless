# Copy to `.env` in this folder (gitignored) or export in your shell.
# `playwright.config.ts` also merges repo `.env`, `apps/web/.env`, and `apps/stories/.env`.

# --- Main website (apps/web) ---

# Reuse a dev server instead of starting Vite from Playwright.
# When set, the managed webServer block is skipped.
# E2E_WEB_BASE_URL=http://127.0.0.1:6339

# Port for the Playwright-managed Vite server (default: 6339).
# Ignored when E2E_WEB_BASE_URL is set.
# E2E_WEB_PORT=6339

# --- Component catalog (apps/stories) ---

# E2E_STORIES_BASE_URL=http://127.0.0.1:6341
# E2E_STORIES_PORT=6341

# Optional path to an extra env file merged into the managed web server.
# Must be set before Playwright loads config (shell export or this `.env` file).
# E2E_ENV_FILE=/absolute/path/to/stack.env

# --- Playwright run behavior ---

# Milliseconds between browser actions (headed debugging).
# E2E_SLOW_MO=500

# Timezone passed to the managed web dev server (default: UTC).
# TZ=UTC
