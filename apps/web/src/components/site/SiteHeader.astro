---
import { storiesUrl } from '../../lib/stories'

type Props = { home?: boolean }
const { home = false } = Astro.props
const sectionPrefix = home ? '' : '/'

/**
 * One declaration for both surfaces: the inline bar on wide viewports and the popover panel the
 * hamburger opens once the bar no longer fits. Only ever one of the two is rendered.
 */
const sections = [
  { href: `${sectionPrefix}#ingredients`, label: 'Ingredients' },
  { href: `${sectionPrefix}#principles`, label: 'Principles' },
  { href: `${sectionPrefix}#enhancement`, label: 'Before JS' },
  { href: '/docs/', label: 'Docs' },
  { href: '/docs/reference/agents/', label: 'AI' },
  { href: storiesUrl(), label: 'Stories' },
]
---

<header class="site-nav" aria-label="Primary">
  <div class="site-nav__menu">
    <a class="brand" href={home ? '#top' : '/'} aria-label="Timeless home">
      <span>Timeless</span>
    </a>

    <nav class="nav-links" aria-label="Page sections">
      {sections.map((section) => <a href={section.href}>{section.label}</a>)}
    </nav>

    <button
      class="nav-toggle"
      type="button"
      popovertarget="site-nav-panel"
      aria-expanded="false"
      aria-label="Page sections"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 6h18v2.2H3V6Zm0 4.9h18v2.2H3v-2.2ZM3 15.8h18V18H3v-2.2Z"></path>
      </svg>
    </button>
  </div>

  <nav class="nav-panel" id="site-nav-panel" popover="auto" aria-label="Page sections">
    {sections.map((section) => <a href={section.href}>{section.label}</a>)}
  </nav>

  <a
    class="github-link"
    href="https://github.com/itsjavi/timeless"
    rel="noopener noreferrer"
    target="_blank"
    aria-label="Timeless GitHub repository"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 .5C5.65.5.5 5.66.5 12.02c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-.99-.02-1.94-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.71 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.44-2.69 5.42-5.25 5.7.41.36.78 1.07.78 2.15 0 1.55-.02 2.8-.02 3.18 0 .3.21.66.79.55 4.56-1.52 7.85-5.83 7.85-10.91C23.5 5.66 18.35.5 12 .5Z"
      ></path>
    </svg>
    <span>GitHub</span>
  </a>
</header>

<script>
  /**
   * The panel opens, light-dismisses, and Escape-closes natively. This adds the two things
   * `popovertarget` does not: the disclosure state on the trigger, and closing the panel when a
   * link inside it only moves to a fragment of the page already loaded.
   */
  const panel = document.getElementById('site-nav-panel')
  const toggle = document.querySelector('.nav-toggle')

  if (panel && toggle) {
    panel.addEventListener('toggle', (event) => {
      toggle.setAttribute('aria-expanded', String((event as ToggleEvent).newState === 'open'))
    })

    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        panel.hidePopover()
      }
    })
  }
</script>
