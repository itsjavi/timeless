{
  "name": "@timelessui/core",
  "version": "0.1.0",
  "description": "Thin Web Components authoring layer for Timeless UI.",
  "keywords": [
    "custom-elements",
    "framework-agnostic",
    "web-components"
  ],
  "homepage": "https://timeless.build",
  "bugs": {
    "url": "https://github.com/itsjavi/timeless/issues"
  },
  "license": "MIT",
  "author": "Javi Aguilar (https://github.com/itsjavi)",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsjavi/timeless.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "publint": "publint --strict --pack=false",
    "attw": "attw --pack --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
